node_modules/
.env

# Kredensial service account Firebase (push notification FCM).
# JANGAN pernah di-commit — berisi private key yang bisa mengirim push
# atas nama project Firebase.
secrets/
*firebase-adminsdk*.json
*service-account*.json

# Lampiran disimpan per kategori (izin/sakit/cuti) + folder staging sementara.
uploads/surat-izin/*
!uploads/surat-izin/.gitkeep
!uploads/surat-izin/izin/
!uploads/surat-izin/sakit/
!uploads/surat-izin/cuti/
uploads/surat-izin/izin/*
uploads/surat-izin/sakit/*
uploads/surat-izin/cuti/*
!uploads/surat-izin/*/.gitkeep
uploads/qrcode/*
!uploads/qrcode/.gitkeep
*.log
.DS_Store

# Knowledge graph graphify (auto-rebuild oleh post-commit hook)
graphify-out/
