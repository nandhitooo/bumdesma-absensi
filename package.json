{
  "name": "bumdesma-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Sistem Absensi BUMDESMA - frontend React/Vite + backend Express/Sequelize",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:all": "concurrently -n BACKEND,FRONTEND -c green,cyan -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
